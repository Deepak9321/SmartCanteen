<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>
        Smart Canteen ·
        <%= defaultRole === 'manager' ? 'Manager Login' : 'Student Login' %>
    </title>

    <link rel="stylesheet" href="/css/app.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body.login-page {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, Arial, sans-serif;
            background:
                radial-gradient(
                    circle at 10% 15%,
                    rgba(16, 185, 129, .16),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 90% 85%,
                    rgba(59, 130, 246, .12),
                    transparent 30%
                ),
                linear-gradient(
                    135deg,
                    #f0fdf9,
                    #f8fafc 55%,
                    #ecfdf5
                );
            overflow-x: hidden;
        }

        /* ---------------------------
           BACKGROUND
        --------------------------- */

        .bg-orb {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(1px);
            animation: orbFloat 7s ease-in-out infinite;
        }

        .bg-orb.one {
            width: 110px;
            height: 110px;
            left: 7%;
            top: 10%;
            background: rgba(16, 185, 129, .11);
        }

        .bg-orb.two {
            width: 160px;
            height: 160px;
            right: 6%;
            bottom: 7%;
            background: rgba(59, 130, 246, .08);
            animation-delay: 1.5s;
        }

        @keyframes orbFloat {
            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-20px);
            }
        }

        /* ---------------------------
           MAIN
        --------------------------- */

        .login-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
        }

        .login-container {
            width: min(1050px, 100%);
            min-height: 630px;

            display: grid;
            grid-template-columns: 43% 57%;

            overflow: hidden;

            background: rgba(255, 255, 255, .84);
            backdrop-filter: blur(20px);

            border: 1px solid rgba(255, 255, 255, .9);
            border-radius: 32px;

            box-shadow:
                0 30px 80px rgba(15, 23, 42, .15),
                0 10px 30px rgba(16, 185, 129, .08);

            animation: containerIn .7s ease both;
        }

        @keyframes containerIn {
            from {
                opacity: 0;
                transform: translateY(25px) scale(.97);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* ---------------------------
           LEFT SIDE
        --------------------------- */

        .login-visual {
            position: relative;
            overflow: hidden;

            padding: 42px;

            color: white;

            background:
                radial-gradient(
                    circle at 75% 20%,
                    rgba(255, 255, 255, .16),
                    transparent 25%
                ),
                linear-gradient(
                    145deg,
                    #064e3b,
                    #047857 55%,
                    #059669
                );

            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .login-visual::before {
            content: "";

            position: absolute;

            width: 300px;
            height: 300px;

            border-radius: 50%;

            background: rgba(255, 255, 255, .05);

            top: -120px;
            right: -100px;
        }

        .login-visual::after {
            content: "";

            position: absolute;

            width: 220px;
            height: 220px;

            border-radius: 50%;

            background: rgba(255, 255, 255, .05);

            bottom: -100px;
            left: -70px;
        }

        /* ---------------------------
           BRAND
        --------------------------- */

        .brand {
            position: relative;
            z-index: 2;

            display: flex;
            align-items: center;

            gap: 13px;
        }

        .brand-logo {
            width: 55px;
            height: 55px;

            display: grid;
            place-items: center;

            border-radius: 17px;

            background: rgba(255, 255, 255, .15);

            border:
                1px solid
                rgba(255, 255, 255, .24);

            backdrop-filter: blur(10px);

            font-size: 20px;
            font-weight: 900;
        }

        .brand strong {
            font-size: 19px;
        }

        .brand small {
            display: block;

            margin-top: 3px;

            opacity: .68;
        }

        /* ---------------------------
           VISUAL CONTENT
        --------------------------- */

        .visual-content {
            position: relative;
            z-index: 2;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 7px;

            padding: 8px 13px;

            border-radius: 100px;

            background: rgba(255, 255, 255, .11);

            border:
                1px solid
                rgba(255, 255, 255, .17);

            font-size: 12px;
            font-weight: 800;

            margin-bottom: 20px;
        }

        .visual-content h1 {
            margin: 0;

            font-size: clamp(34px, 4vw, 50px);

            line-height: 1.02;

            letter-spacing: -2px;
        }

        .visual-content h1 span {
            color: #a7f3d0;
        }

        .visual-content p {
            max-width: 350px;

            margin: 18px 0 25px;

            color: rgba(255, 255, 255, .76);

            line-height: 1.7;

            font-size: 14px;
        }

        /* ---------------------------
           FEATURES
        --------------------------- */

        .features {
            display: grid;
            gap: 11px;
        }

        .feature {
            display: flex;
            align-items: center;

            gap: 10px;

            color: rgba(255, 255, 255, .88);

            font-size: 13px;
        }

        .feature-icon {
            width: 31px;
            height: 31px;

            display: grid;
            place-items: center;

            border-radius: 10px;

            background: rgba(255, 255, 255, .12);
        }

        /* ---------------------------
           FOOD CARD
        --------------------------- */

        .food-card {
            position: absolute;

            right: 35px;
            top: 39%;

            width: 125px;
            height: 125px;

            z-index: 2;

            animation:
                foodFloat
                4s
                ease-in-out
                infinite;
        }

        .food-main {
            width: 100%;
            height: 100%;

            display: grid;
            place-items: center;

            border-radius: 38px;

            background: rgba(255, 255, 255, .14);

            border:
                1px solid
                rgba(255, 255, 255, .2);

            backdrop-filter: blur(12px);

            font-size: 65px;

            box-shadow:
                0 20px 45px
                rgba(0, 0, 0, .16);

            transform: rotate(-8deg);
        }

        .food-mini {
            position: absolute;

            width: 42px;
            height: 42px;

            display: grid;
            place-items: center;

            border-radius: 14px;

            background: white;

            box-shadow:
                0 10px 25px
                rgba(0, 0, 0, .15);

            font-size: 20px;
        }

        .food-mini.one {
            right: -15px;
            top: -12px;
        }

        .food-mini.two {
            left: -18px;
            bottom: -10px;
        }

        @keyframes foodFloat {
            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-13px);
            }
        }

        /* ---------------------------
           RIGHT SIDE
        --------------------------- */

        .login-form-area {
            padding: 50px 58px;

            display: flex;
            flex-direction: column;

            justify-content: center;
        }

        .form-header {
            margin-bottom: 28px;
        }

        .form-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;

            padding: 8px 12px;

            border-radius: 100px;

            background: #ecfdf5;

            color: #047857;

            font-size: 12px;
            font-weight: 800;

            margin-bottom: 14px;
        }

        .form-header h2 {
            margin: 0;

            color: #0f172a;

            font-size: 34px;

            letter-spacing: -1.2px;
        }

        .form-header p {
            margin: 9px 0 0;

            color: #64748b;

            font-size: 14px;

            line-height: 1.6;
        }

        /* ---------------------------
           ALERT
        --------------------------- */

        .alert {
            padding: 13px 15px;

            margin-bottom: 18px;

            border-radius: 13px;

            background: #fef2f2;

            border:
                1px solid
                #fecaca;

            color: #b91c1c;

            font-size: 13px;
        }

        .success-alert {
            padding: 13px 15px;

            margin-bottom: 18px;

            border-radius: 13px;

            background: #ecfdf5;

            border:
                1px solid
                #a7f3d0;

            color: #047857;

            font-size: 13px;
        }

        /* ---------------------------
           FORM
        --------------------------- */

        .login-form {
            display: grid;
            gap: 18px;
        }

        .field label {
            display: block;

            margin-bottom: 7px;

            color: #334155;

            font-size: 12px;

            font-weight: 800;
        }

        .input-wrap {
            position: relative;
        }

        .input-icon {
            position: absolute;

            left: 14px;
            top: 50%;

            transform: translateY(-50%);

            font-size: 17px;

            opacity: .6;

            pointer-events: none;
        }

        .field input {
            width: 100%;
            height: 52px;

            padding:
                0
                46px
                0
                43px;

            border:
                1px solid
                #dbe4ea;

            border-radius: 14px;

            outline: none;

            background:
                rgba(248, 250, 252, .85);

            color: #0f172a;

            font-size: 14px;

            transition: .25s ease;
        }

        .field input:focus {
            border-color: #10b981;

            background: white;

            box-shadow:
                0 0 0 4px
                rgba(16, 185, 129, .11);

            transform: translateY(-1px);
        }

        .field input::placeholder {
            color: #94a3b8;
        }

        /* ---------------------------
           PASSWORD BUTTON
        --------------------------- */

        .password-toggle {
            position: absolute;

            right: 9px;
            top: 50%;

            transform: translateY(-50%);

            border: 0;

            background: transparent;

            cursor: pointer;

            padding: 7px;

            font-size: 16px;

            opacity: .6;
        }

        .password-toggle:hover {
            opacity: 1;
        }

        /* ---------------------------
           REMEMBER
        --------------------------- */

        .form-options {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 10px;

            margin-top: -4px;
        }

        .remember {
            display: flex;

            align-items: center;

            gap: 7px;

            color: #64748b;

            font-size: 12px;

            cursor: pointer;
        }

        .remember input {
            accent-color: #059669;

            width: 15px;
            height: 15px;
        }

        .forgot {
            color: #047857;

            font-size: 12px;

            font-weight: 700;

            text-decoration: none;
        }

        .forgot:hover {
            text-decoration: underline;
        }

        /* ---------------------------
           LOGIN BUTTON
        --------------------------- */

        .login-btn {
            width: 100%;
            height: 53px;

            border: 0;

            border-radius: 15px;

            cursor: pointer;

            color: white;

            font-size: 15px;

            font-weight: 800;

            background:
                linear-gradient(
                    135deg,
                    #059669,
                    #10b981
                );

            box-shadow:
                0 12px 25px
                rgba(5, 150, 105, .22);

            transition: .25s ease;
        }

        .login-btn:hover {
            transform: translateY(-2px);

            box-shadow:
                0 17px 32px
                rgba(5, 150, 105, .28);
        }

        .login-btn:active {
            transform: translateY(0);
        }

        /* ---------------------------
           CREATE ACCOUNT
        --------------------------- */

        .create-account {
            text-align: center;

            margin-top: 20px;

            padding-top: 20px;

            border-top:
                1px solid
                #e2e8f0;

            color: #64748b;

            font-size: 13px;
        }

        .create-account a {
            color: #047857;

            font-weight: 800;

            text-decoration: none;
        }

        .create-account a:hover {
            text-decoration: underline;
        }

        /* ---------------------------
           SWITCH ROLE
        --------------------------- */

        .role-switch {
            text-align: center;

            margin-top: 14px;

            color: #94a3b8;

            font-size: 11px;
        }

        .role-switch a {
            color: #475569;

            font-weight: 800;

            text-decoration: none;
        }

        .role-switch a:hover {
            color: #047857;
        }

        /* ---------------------------
           DEMO ACCOUNT
        --------------------------- */

        .demo-account {
            margin-top: 20px;

            padding: 13px 15px;

            border-radius: 14px;

            background: #f8fafc;

            border:
                1px solid
                #e2e8f0;

            color: #64748b;

            font-size: 11px;
        }

        .demo-account strong {
            display: block;

            color: #334155;

            margin-bottom: 4px;
        }

        .demo-account span {
            display: block;

            line-height: 1.6;
        }

        /* ---------------------------
           MOBILE
        --------------------------- */

        @media (max-width: 850px) {

            .login-container {
                grid-template-columns: 1fr;

                max-width: 600px;
            }

            .login-visual {
                min-height: 300px;

                padding: 30px;
            }

            .visual-content {
                max-width: 65%;
            }

            .food-card {
                right: 35px;

                transform: scale(.8);
            }

            .login-form-area {
                padding: 35px 30px;
            }
        }

        @media (max-width: 560px) {

            .login-shell {
                padding: 15px;
            }

            .login-container {
                border-radius: 22px;
            }

            .login-visual {
                min-height: 270px;
            }

            .visual-content {
                max-width: 100%;
            }

            .visual-content h1 {
                font-size: 35px;
            }

            .food-card {
                display: none;
            }

            .login-form-area {
                padding: 30px 20px;
            }

            .form-header h2 {
                font-size: 29px;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</head>


<body class="login-page">

    <div class="bg-orb one"></div>
    <div class="bg-orb two"></div>


    <main class="login-shell">

        <section class="login-container">


            <!-- =================================
                 LEFT VISUAL PANEL
            ================================== -->

            <aside class="login-visual">


                <!-- BRAND -->

                <div class="brand">

                    <div class="brand-logo">
                        SC
                    </div>

                    <div>
                        <strong>
                            Smart Canteen
                        </strong>

                        <small>
                            Order smart. Waste less.
                        </small>
                    </div>

                </div>


                <!-- CONTENT -->

                <div class="visual-content">


                    <% if (defaultRole === 'manager') { %>

                        <div class="eyebrow">
                            🧑‍💼 Manager Portal
                        </div>

                        <h1>
                            Manage your<br>
                            <span>canteen smarter.</span>
                        </h1>

                        <p>
                            Manage orders, menu, inventory,
                            sales and AI-powered demand insights
                            from one place.
                        </p>

                        <div class="features">

                            <div class="feature">
                                <span class="feature-icon">
                                    📊
                                </span>

                                <span>
                                    Track sales and orders
                                </span>
                            </div>

                            <div class="feature">
                                <span class="feature-icon">
                                    🤖
                                </span>

                                <span>
                                    AI demand forecasting
                                </span>
                            </div>

                            <div class="feature">
                                <span class="feature-icon">
                                    ♻️
                                </span>

                                <span>
                                    Reduce food waste
                                </span>
                            </div>

                        </div>


                    <% } else { %>


                        <div class="eyebrow">
                            🎓 Student Portal
                        </div>

                        <h1>
                            Welcome<br>
                            <span>back, student.</span>
                        </h1>

                        <p>
                            Login to explore today's menu,
                            order your favourite food and
                            track your pickup.
                        </p>

                        <div class="features">

                            <div class="feature">
                                <span class="feature-icon">
                                    🍔
                                </span>

                                <span>
                                    Order food quickly
                                </span>
                            </div>

                            <div class="feature">
                                <span class="feature-icon">
                                    ⚡
                                </span>

                                <span>
                                    Skip long queues
                                </span>
                            </div>

                            <div class="feature">
                                <span class="feature-icon">
                                    📱
                                </span>

                                <span>
                                    Easy QR pickup
                                </span>
                            </div>

                        </div>


                    <% } %>

                </div>


                <!-- FOOD ANIMATION -->

                <div class="food-card">

                    <div class="food-main">
                        🍱
                    </div>

                    <div class="food-mini one">
                        🥤
                    </div>

                    <div class="food-mini two">
                        🍟
                    </div>

                </div>


                <div
                    style="
                        position:relative;
                        z-index:2;
                        font-size:11px;
                        opacity:.55;
                    "
                >
                    Smart Canteen • Campus Food Experience
                </div>

            </aside>



            <!-- =================================
                 RIGHT LOGIN FORM
            ================================== -->

            <section class="login-form-area">


                <div class="form-header">

                    <div class="form-badge">

                        <%= defaultRole === 'manager'
                            ? '🧑‍💼 Manager Account'
                            : '🎓 Student Account'
                        %>

                    </div>


                    <h2>

                        <%= defaultRole === 'manager'
                            ? 'Welcome, Manager'
                            : 'Welcome back'
                        %>

                    </h2>


                    <p>

                        <%= defaultRole === 'manager'
                            ? 'Sign in to manage your Smart Canteen operations.'
                            : 'Login to continue your Smart Canteen experience.'
                        %>

                    </p>

                </div>



                <!-- ERROR -->

                <% if (error) { %>

                    <div class="alert">

                        ⚠️ <%= error %>

                    </div>

                <% } %>



                <!-- SUCCESS -->

                <% if (success) { %>

                    <div class="success-alert">

                        ✓ <%= success %>

                    </div>

                <% } %>



                <!-- LOGIN FORM -->

                <form
                    method="post"
                    action="<%= defaultRole === 'manager'
                        ? '/manager/login'
                        : '/login'
                    %>"
                    class="login-form"
                >


                    <input
                        type="hidden"
                        name="role"
                        value="<%= defaultRole %>"
                    >



                    <!-- EMAIL -->

                    <div class="field">

                        <label for="email">
                            Email Address
                        </label>

                        <div class="input-wrap">

                            <span class="input-icon">
                                ✉️
                            </span>

                            <input
                                id="email"
                                name="email"
                                type="email"
                                placeholder="you@example.com"
                                autocomplete="email"
                                required
                            >

                        </div>

                    </div>



                    <!-- PASSWORD -->

                    <div class="field">

                        <label for="password">
                            Password
                        </label>

                        <div class="input-wrap">

                            <span class="input-icon">
                                🔒
                            </span>

                            <input
                                id="password"
                                name="password"
                                type="password"
                                placeholder="Enter your password"
                                autocomplete="current-password"
                                required
                            >

                            <button
                                type="button"
                                class="password-toggle"
                                onclick="togglePassword()"
                                aria-label="Show password"
                            >
                                👁️
                            </button>

                        </div>

                    </div>



                    <!-- OPTIONS -->

                    <div class="form-options">

                        <label class="remember">

                            <input
                                type="checkbox"
                                name="remember"
                            >

                            Remember me

                        </label>


                        <a
                            href="#"
                            class="forgot"
                            onclick="alert('Please contact the canteen administrator to reset your password.'); return false;"
                        >
                            Forgot password?
                        </a>

                    </div>



                    <!-- BUTTON -->

                    <button
                        type="submit"
                        class="login-btn"
                    >

                        <%= defaultRole === 'manager'
                            ? 'Login as Manager →'
                            : 'Login as Student →'
                        %>

                    </button>

                </form>



                <!-- STUDENT CREATE ACCOUNT -->

                <% if (defaultRole === 'student') { %>

                    <div class="create-account">

                        Don't have a student account?

                        <a href="/register">
                            Create Account
                        </a>

                    </div>

                <% } %>



                <!-- ROLE SWITCH -->

                <div class="role-switch">

                    <% if (defaultRole === 'manager') { %>

                        Are you a student?

                        <a href="/login">
                            Student Login →
                        </a>

                    <% } else { %>

                        Canteen Manager?

                        <a href="/manager/login">
                            Manager Login →
                        </a>

                    <% } %>

                </div>



                <!-- DEMO ACCOUNT -->

                <div class="demo-account">

                    <% if (defaultRole === 'manager') { %>

                        <strong>
                            🧪 Demo Manager Account
                        </strong>

                        <span>
                            Email:
                            manager@smartcanteen.com
                        </span>

                        <span>
                            Password:
                            Manager@123
                        </span>

                    <% } else { %>

                        <strong>
                            🧪 Demo Student Account
                        </strong>

                        <span>
                            Email:
                            student@smartcanteen.com
                        </span>

                        <span>
                            Password:
                            Student@123
                        </span>

                    <% } %>

                </div>


            </section>

        </section>

    </main>



    <script>

        function togglePassword() {

            const input =
                document.getElementById("password");

            const button =
                document.querySelector(".password-toggle");


            if (input.type === "password") {

                input.type = "text";

                button.textContent = "🙈";

            } else {

                input.type = "password";

                button.textContent = "👁️";

            }

        }

    </script>

</body>

</html>